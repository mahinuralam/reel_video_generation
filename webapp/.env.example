# Copy to .env.local and adjust. scripts/start.sh and Next.js both read .env.local.

# MongoDB runs on this machine only (scripts/start.sh starts it from ../env/mongodb).
MONGODB_URI=mongodb://127.0.0.1:27017
# Leave MONGODB_DB unset to get avatar_studio (real) or avatar_studio_mock (when MOCK=1).
# MONGODB_DB=avatar_studio

# 1 = simulate the pipeline (fast, no API calls, makes a test-pattern video). 0 = run the real pipeline.
MOCK=0

# Mock speed: milliseconds per simulated avatar clip (real: about 90000).
MOCK_SEG_MS=1500

