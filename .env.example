# Copy to .env (chmod 600) and fill in. Every pipeline script reads it through src/setup/common.sh.

# Claude designs each video's storyboard. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Voice clone, transcription, avatar clips and music. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: InfiniteTalk and LongCat avatar models (AVATAR_ENGINE=infinitetalk or longcat). https://wavespeed.ai
WAVESPEED_API_KEY=
# WAVESPEED_CONCURRENCY=2   # jobs WaveSpeed runs at once on this account

# Optional: OmniHuman 2.0 avatar model (AVATAR_ENGINE=omnihuman). https://fal.ai/dashboard/keys
FAL_KEY=

# Optional: local LongCat (AVATAR_ENGINE=longcat-local), one 32 GB GPU; paths are relative to the project
# LONGCAT_ENV=env/longcat
# LONGCAT_REPO=third_party/LongCat-Video
# LONGCAT_WEIGHTS=weights/LongCat-Video-Avatar-1.6
# LONGCAT_RESOLUTION=720p   # or 480p
