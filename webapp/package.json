{
  "name": "avatar-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Avatar Studio: web front end (Next.js + MongoDB) for the avatar video pipeline",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
